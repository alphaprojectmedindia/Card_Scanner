# ==============================================================================
# Digital Share API - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to '.env' or configure environment variables in your deployment / IDE.
# In local development, you may also use 'dotnet user-secrets'.
# ==============================================================================

# Database Connection (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=digital_share_db;Username=postgres;Password=postgres

# JWT Authentication
Jwt__Issuer=DigitalShare.Api
Jwt__Audience=DigitalShare.MobileApp
Jwt__SecretKey=YOUR_HIGH_ENTROPY_256_BIT_SECRET_KEY_HERE_MIN_32_CHARS
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenExpiryDays=30

# Temporary Scan Storage Configuration
# Provider: 'Local' (for offline dev/tests) or 'R2' (Cloudflare R2 object storage)
Storage__Provider=Local

# Local Storage Settings (used when Storage__Provider=Local)
Storage__Local__Directory=uploads/temp-scans
Storage__Local__MaxFileSizeMb=20

# Cloudflare R2 Settings (used when Storage__Provider=R2)
# Obtain these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
Storage__R2__AccountId=YOUR_CLOUDFLARE_ACCOUNT_ID
Storage__R2__AccessKeyId=YOUR_R2_ACCESS_KEY_ID
Storage__R2__SecretAccessKey=YOUR_R2_SECRET_ACCESS_KEY
Storage__R2__BucketName=digitalshare-scans-dev
Storage__R2__ServiceUrl=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
Storage__R2__PresignedExpiryMinutes=15
Storage__R2__MaxFileSizeMb=20

# Google Gemini API Configuration (Semantic Card Parser & Extraction Engine)
# Kept strictly on the backend. Never share with or configure on client/mobile.
Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE
Gemini__ModelId=gemini-3.8-flash
Gemini__FallbackModelId=gemini-3.5-flash-lite
Gemini__Enabled=true
Gemini__TimeoutSeconds=8
Gemini__MaxRetries=2
